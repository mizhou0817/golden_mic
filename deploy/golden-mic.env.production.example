# Copy to /etc/golden-mic/golden-mic.env, replace every CHANGE_ME value,
# then set ownership root:goldenmic and mode 0640. Never place this file in a release.

APP_ENV=production
ENABLE_API_DOCS=false
ENFORCE_ORIGIN_CHECK=true
# Production always has no login and requires signed anonymous browser sessions,
# CSRF + Origin checks, per-session/IP/global quotas, and per-task capabilities.
# A reverse proxy or direct loopback request never gains a global task index.
# Generate directly on the server, for example: openssl rand -base64 48
ANONYMOUS_SESSION_SECRET=CHANGE_ME_RANDOM_48_BYTE_SECRET
ANONYMOUS_SESSION_TTL_SECONDS=86400
ANONYMOUS_SESSION_TASK_RATE_LIMIT_PER_HOUR=2
ANONYMOUS_IP_TASK_RATE_LIMIT_PER_HOUR=5
ANONYMOUS_GLOBAL_TASK_RATE_LIMIT_PER_HOUR=10
ALLOWED_HOSTS=CHANGE_ME_DOMAIN,127.0.0.1,localhost
FRONTEND_ORIGINS=https://CHANGE_ME_DOMAIN

DATA_DIR=/srv/golden-mic-data/tasks
ASR_CACHE_ENABLED=true
ASR_CACHE_DIR=/srv/golden-mic-data/cache/asr
ASR_CACHE_TTL_HOURS=168
ASR_CACHE_MAX_ENTRIES=5000
ASR_SPARSE_RETRY_ENABLED=true
TASK_TTL_HOURS=72
MIN_FREE_DISK_GB=50
TASK_DISK_RESERVATION_MULTIPLIER=8
MEDIA_COMMAND_TIMEOUT_SECONDS=6800

MAX_UPLOAD_MB=500
MAX_TOTAL_UPLOAD_MB=5120
MAX_CONCURRENT_UPLOADS=1
MAX_FILES=20
MAX_SOURCE_DURATION_SECONDS_PER_FILE=1800
MAX_TOTAL_SOURCE_DURATION_SECONDS=3600
MAX_SOURCE_WIDTH=7680
MAX_SOURCE_HEIGHT=4320
MAX_SOURCE_FRAME_RATE=120
MAX_SHOTS=120
MAX_SENTENCES=200
MAX_CONCURRENT_TASKS=1
MAX_PENDING_TASKS=5
SHUTDOWN_GRACE_SECONDS=6900
TASK_RATE_LIMIT_PER_HOUR=5

KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=CHANGE_ME
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=low

VISION_PROVIDER=kimi
# Shared only with Doubao Embedding Vision while EMBEDDING_PROVIDER=volcengine;
# VOLCENGINE_EMBEDDING_API_KEYS is not a supported field.
VOLCENGINE_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_VISION_API_KEYS=CHANGE_ME
VOLCENGINE_VISION_MODEL=doubao-seed-2-1-pro-260628
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

EMBEDDING_PROVIDER=volcengine
VOLCENGINE_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_EMBEDDING_MODEL=doubao-embedding-vision-251215
VOLCENGINE_EMBEDDING_DIMENSIONS=2048
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
RETRIEVAL_TOP_K=10
RETRIEVAL_LEXICAL_RESCUE_K=4
ENTITY_VERIFICATION_ENABLED=true
ENTITY_VERIFICATION_MAX_SHOTS=6
ENTITY_VERIFICATION_MIN_CONFIDENCE=0.75
VIDEO_EMBEDDING_ENABLED=true
VIDEO_EMBEDDING_CANDIDATE_TOP_K=15
VIDEO_EMBEDDING_FPS=0.5
VIDEO_EMBEDDING_MAX_VIDEO_TOKENS=10240
VIDEO_EMBEDDING_CONCURRENCY=4
VIDEO_EMBEDDING_GLOBAL_CONCURRENCY=4
VIDEO_EMBEDDING_GLOBAL_MAX_CONCURRENCY=8
VIDEO_EMBEDDING_MIN_CONCURRENCY=2
VIDEO_EMBEDDING_ADAPTIVE_CONCURRENCY=false
VIDEO_EMBEDDING_ADAPTIVE_SUCCESS_WINDOW=20
VIDEO_EMBEDDING_TOTAL_TIMEOUT_SECONDS=300
VIDEO_EMBEDDING_CONNECT_TIMEOUT_SECONDS=10
VIDEO_EMBEDDING_WRITE_TIMEOUT_SECONDS=120
VIDEO_EMBEDDING_READ_TIMEOUT_SECONDS=120
VIDEO_EMBEDDING_POOL_TIMEOUT_SECONDS=30

LLM_PROVIDER=kimi
# Kimi mode uses KIMI_API_KEY. The following Doubao LLM values are rollback-only.
VOLCENGINE_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_LLM_API_KEYS=CHANGE_ME
VOLCENGINE_LLM_MODEL=doubao-seed-2-1-pro-260628
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

TTS_PROVIDER=volcengine
VOLCENGINE_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLCENGINE_TTS_API_KEYS=CHANGE_ME
VOLCENGINE_VOICE_TYPE=zh_male_m191_uranus_bigtts
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_MODEL=
VOLCENGINE_APP_ID=CHANGE_ME
VOLCENGINE_APP_KEY=CHANGE_ME
VOLCENGINE_ACCESS_TOKEN=CHANGE_ME
TTS_NEWS_TARGET_CHARS_PER_MINUTE=255
TTS_NEWS_RATE_TOLERANCE=0.08
TTS_PROVIDER_SPEECH_RATE=0
TTS_PROVIDER_LOUDNESS_RATE=0
TTS_TARGET_LUFS=-20
TTS_TARGET_LRA=5
TTS_TRUE_PEAK_DBFS=-2
TTS_MAX_LOUDNESS_SPREAD_LU=2
TTS_VOICE=zh-CN-YunjianNeural
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1

ASR_PROVIDER=volcengine
VOLCENGINE_ASR_BASE_URL=wss://openspeech.bytedance.com/api/v3/sauc
VOLCENGINE_ASR_CLUSTER_ID=CHANGE_ME
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLCENGINE_ASR_ENDPOINT_PATH=bigmodel_async
ASR_CONCURRENCY=2
# V2 local speech: examples only, outside the release and HTTP-served directories.
# Operator must supply compatible weights/tokenizer and review model/language licenses.
# No installer, network model lookup, automatic download, or new paid provider.
LOCAL_SPEAKER_MODEL_PATH=/srv/golden-mic-private-models/speaker/model.onnx
LOCAL_ALIGNMENT_MODEL_PATH=/srv/golden-mic-private-models/ctc
# Required speech fails closed until an absolute installed manifest is supplied.
# Blank means unconfigured (None), NOT cwd. No manifest discovery or activation.
# Use bundle/installed-manifest.json or an external manifest; both model paths
# must be exact canonical paths in the same bundle. Rehash is integrity only,
# NOT source authenticity, license proof, model compatibility or verified inference.
LOCAL_SPEECH_BUNDLE_MANIFEST_PATH=
LOCAL_SPEECH_LICENSE_REVIEWED=false
LOCAL_SPEECH_REQUIRED=true
SYNC_SOUND_ENABLED=true
SYNC_SOUND_VAD_ENABLED=true
SYNC_SOUND_VAD_THRESHOLD=0.2
SYNC_SOUND_VAD_MIN_SPEECH_MS=32
SYNC_SOUND_SIMILARITY_THRESHOLD=0.88
SYNC_SOUND_MIN_TEXT_OVERLAP=0.2
SYNC_SOUND_MAX_DURATION_SECONDS=15

MUSIC_LIBRARY_DIR=backend/assets/music
MUSIC_BED_TARGET_LUFS=-32
MUSIC_DUCK_RATIO=8
MOTION_ZOOM_RATIO=0.08
COLOR_CONSISTENCY_TARGET_LUFS=-20
GENERATIVE_FILL_ENABLED=false
GENERATIVE_FILL_PROVIDER=volcengine
VOLCENGINE_GEN_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_GEN_API_KEYS=
SEEDANCE_2_0_API_KEY=
VOLCENGINE_GEN_VIDEO_MODEL=doubao-seedance-2-5-260628
VOLCENGINE_GEN_IMAGE_MODEL=doubao-seedream-3-0-t2i-250415
GENERATIVE_FILL_MODE=video
GENERATIVE_FILL_RESOLUTION=1080p
GENERATIVE_FILL_MAX_CLIPS=2
GENERATIVE_FILL_DURATION_SECONDS=5
GENERATIVE_FILL_TIMEOUT_SECONDS=300

QUALITY_GATE_MODE=block
QUALITY_MIN_MATCH_CONFIDENCE=0.5
