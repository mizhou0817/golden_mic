# Local development defaults. Production uses deploy/golden-mic.env.production.example.
# Owned single-machine workspace: bind 127.0.0.1; implicit local history/edit
# access requires direct loopback, a loopback Host and no forwarding headers.
# Local writes without a task token additionally require the exact same Origin.
APP_ENV=development
ENABLE_API_DOCS=true
ENFORCE_ORIGIN_CHECK=false
# Production always requires signed anonymous CSRF + Origin; no login mode switch.
ANONYMOUS_SESSION_SECRET=
ANONYMOUS_SESSION_TTL_SECONDS=86400
ANONYMOUS_SESSION_TASK_RATE_LIMIT_PER_HOUR=2
ANONYMOUS_IP_TASK_RATE_LIMIT_PER_HOUR=5
ANONYMOUS_GLOBAL_TASK_RATE_LIMIT_PER_HOUR=10
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Kimi K3 replaces Doubao Seed 2.1 Pro for Vision and text-LLM tasks.
# Keep the API key only in .env or the production EnvironmentFile.
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=low

VISION_PROVIDER=kimi
# This key list is also used by Doubao Embedding Vision when
# EMBEDDING_PROVIDER=volcengine. There is no VOLCENGINE_EMBEDDING_API_KEYS field.
VOLCENGINE_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_VISION_API_KEYS=
VOLCENGINE_VISION_MODEL=doubao-seed-2-1-pro-260628

# Optional OpenAI-compatible Vision provider
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

EMBEDDING_PROVIDER=volcengine
VOLCENGINE_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_EMBEDDING_MODEL=doubao-embedding-vision-251215
VOLCENGINE_EMBEDDING_DIMENSIONS=2048

# Optional OpenAI-compatible Embedding provider
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

LLM_PROVIDER=kimi
# Kimi mode uses KIMI_API_KEY. These legacy Doubao LLM settings are retained
# only for an explicit provider rollback.
VOLCENGINE_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_LLM_API_KEYS=
VOLCENGINE_LLM_MODEL=doubao-seed-2-1-pro-260628

# Optional OpenAI-compatible LLM provider
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

TTS_PROVIDER=volcengine
VOLCENGINE_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLCENGINE_TTS_API_KEYS=
VOLCENGINE_VOICE_TYPE=zh_male_m191_uranus_bigtts
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_MODEL=
VOLCENGINE_APP_ID=
VOLCENGINE_APP_KEY=
VOLCENGINE_ACCESS_TOKEN=
# Professional Chinese TV-news narration profile. Provider controls remain
# fixed for timbre stability; the pipeline then performs bounded tempo and
# two-pass EBU R128 loudness normalization.
TTS_NEWS_TARGET_CHARS_PER_MINUTE=255
TTS_NEWS_RATE_TOLERANCE=0.08
TTS_PROVIDER_SPEECH_RATE=0
TTS_PROVIDER_LOUDNESS_RATE=0
TTS_TARGET_LUFS=-20
TTS_TARGET_LRA=5
TTS_TRUE_PEAK_DBFS=-2
TTS_MAX_LOUDNESS_SPREAD_LU=2

ASR_PROVIDER=volcengine
VOLCENGINE_ASR_BASE_URL=wss://openspeech.bytedance.com/api/v3/sauc
VOLCENGINE_ASR_CLUSTER_ID=
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLCENGINE_ASR_ENDPOINT_PATH=bigmodel_async
ASR_CONCURRENCY=2
# Local bounded cache; unlike production, paths remain workspace-relative.
ASR_CACHE_ENABLED=true
ASR_CACHE_DIR=data/cache/asr
ASR_CACHE_TTL_HOURS=168
ASR_CACHE_MAX_ENTRIES=5000
# Conservative development override of Settings/production true: no optional
# extra paid ASR retry unless the operator explicitly opts in.
ASR_SPARSE_RETRY_ENABLED=false
# V2 local speech: private operator-supplied files, never downloaded automatically.
# Model paths must not be blank; the optional manifest alone normalizes blank to None.
# These examples intentionally do not exist; model/language/license review is pending.
LOCAL_SPEAKER_MODEL_PATH=private-models/speaker-embedding.onnx
LOCAL_ALIGNMENT_MODEL_PATH=private-models/ctc-zh
# Optional absolute installed manifest; blank preserves metadata-only development.
# When required and configured, exact canonical bundle/speaker/model.onnx and
# bundle/ctc paths must match. Manifest: bundle/installed-manifest.json or external.
# Read-only rehash is prerequisite integrity, NOT authenticity/license/inference proof.
LOCAL_SPEECH_BUNDLE_MANIFEST_PATH=
LOCAL_SPEECH_LICENSE_REVIEWED=false
# Match the Settings development default; do not require unavailable runtimes.
# Optional capabilities still need reviewed models/runtimes; this grants neither.
LOCAL_SPEECH_REQUIRED=false
SYNC_SOUND_ENABLED=true
SYNC_SOUND_VAD_ENABLED=true
SYNC_SOUND_VAD_THRESHOLD=0.2
SYNC_SOUND_VAD_MIN_SPEECH_MS=32
SYNC_SOUND_SIMILARITY_THRESHOLD=0.88
SYNC_SOUND_MIN_TEXT_OVERLAP=0.2
SYNC_SOUND_MAX_DURATION_SECONDS=15

# Optional fallback providers
TTS_VOICE=zh-CN-YunjianNeural
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1

# Optional non-factual fallback visuals. The legacy SEEDANCE_2_0_API_KEY name
# is retained for compatibility; it stores a generic Ark API key and can call Seedance 2.5.
GENERATIVE_FILL_ENABLED=false
GENERATIVE_FILL_PROVIDER=volcengine
VOLCENGINE_GEN_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_GEN_API_KEYS=
SEEDANCE_2_0_API_KEY=
VOLCENGINE_GEN_VIDEO_MODEL=doubao-seedance-2-5-260628
VOLCENGINE_GEN_IMAGE_MODEL=doubao-seedream-3-0-t2i-250415
GENERATIVE_FILL_MODE=video
GENERATIVE_FILL_RESOLUTION=1080p
GENERATIVE_FILL_MAX_CLIPS=2
GENERATIVE_FILL_DURATION_SECONDS=5
GENERATIVE_FILL_TIMEOUT_SECONDS=300

# Bundled-media tuning defaults, not feature opt-ins or provider credentials.
MUSIC_LIBRARY_DIR=backend/assets/music
MUSIC_BED_TARGET_LUFS=-32
MUSIC_DUCK_RATIO=8
MOTION_ZOOM_RATIO=0.08
COLOR_CONSISTENCY_TARGET_LUFS=-20

MAX_UPLOAD_MB=500
MAX_FILES=20
MAX_SHOTS=120
MAX_SENTENCES=200
RETRIEVAL_TOP_K=10
RETRIEVAL_LEXICAL_RESCUE_K=4
# Conservative development override of Settings/production true: no optional
# paid entity-verification calls. Limits apply only after explicit opt-in.
ENTITY_VERIFICATION_ENABLED=false
ENTITY_VERIFICATION_MAX_SHOTS=6
ENTITY_VERIFICATION_MIN_CONFIDENCE=0.75
VIDEO_EMBEDDING_ENABLED=true
VIDEO_EMBEDDING_CANDIDATE_TOP_K=15
VIDEO_EMBEDDING_FPS=0.5
VIDEO_EMBEDDING_MAX_VIDEO_TOKENS=10240
VIDEO_EMBEDDING_CONCURRENCY=4
VIDEO_EMBEDDING_GLOBAL_CONCURRENCY=4
VIDEO_EMBEDDING_GLOBAL_MAX_CONCURRENCY=8
VIDEO_EMBEDDING_MIN_CONCURRENCY=2
VIDEO_EMBEDDING_ADAPTIVE_CONCURRENCY=false
VIDEO_EMBEDDING_ADAPTIVE_SUCCESS_WINDOW=20
VIDEO_EMBEDDING_TOTAL_TIMEOUT_SECONDS=300
VIDEO_EMBEDDING_CONNECT_TIMEOUT_SECONDS=10
VIDEO_EMBEDDING_WRITE_TIMEOUT_SECONDS=120
VIDEO_EMBEDDING_READ_TIMEOUT_SECONDS=120
VIDEO_EMBEDDING_POOL_TIMEOUT_SECONDS=30
QUALITY_GATE_MODE=warn
QUALITY_MIN_MATCH_CONFIDENCE=0.5
# Legacy local tasks keep manual retention; new mode tasks always retain for 72 hours.
TASK_TTL_HOURS=0
# Development storage/capacity defaults from Settings, not production sizing.
DATA_DIR=data/tasks
MIN_FREE_DISK_GB=5
TASK_DISK_RESERVATION_MULTIPLIER=8
MEDIA_COMMAND_TIMEOUT_SECONDS=7200
MAX_TOTAL_UPLOAD_MB=5120
MAX_CONCURRENT_UPLOADS=2
MAX_SOURCE_DURATION_SECONDS_PER_FILE=1800
MAX_TOTAL_SOURCE_DURATION_SECONDS=3600
MAX_SOURCE_WIDTH=7680
MAX_SOURCE_HEIGHT=4320
MAX_SOURCE_FRAME_RATE=120
MAX_CONCURRENT_TASKS=1
MAX_PENDING_TASKS=5
SHUTDOWN_GRACE_SECONDS=7500
TASK_RATE_LIMIT_PER_HOUR=5
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
